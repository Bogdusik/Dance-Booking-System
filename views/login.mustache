<!DOCTYPE html>
<html lang="en">
<head>
  <title>Login · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap auth">
    <form action="/auth/login" method="post" class="auth-card form-grid">
      <div>
        <h1 class="page-title">Welcome back</h1>
        <p class="page-lead">Log in to manage your bookings or the studio.</p>
      </div>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" type="password" name="password" autocomplete="current-password" required />
      </div>
      <button type="submit" class="btn btn-primary btn-block">Log in</button>
      <p class="auth-switch">New here? <a href="/auth/register">Create an account</a></p>
    </form>
  </main>

  {{> partials/foot}}
</body>
</html>
