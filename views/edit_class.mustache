<!DOCTYPE html>
<html lang="en">
<head>
  <title>Edit session · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap auth">
    <form action="/organiser/edit-class/{{cls._id}}" method="post" class="auth-card form-grid">
      <div>
        <span class="eyebrow">Edit session</span>
        <h1 class="page-title">{{courseName}}</h1>
      </div>
      <div class="form-row">
        <div class="field">
          <label for="date">Date</label>
          <input id="date" type="date" name="date" value="{{cls.date}}" required />
        </div>
        <div class="field">
          <label for="time">Time</label>
          <input id="time" type="time" name="time" value="{{cls.time}}" required />
        </div>
      </div>
      <div class="field">
        <label for="location">Location</label>
        <input id="location" name="location" value="{{cls.location}}" required />
      </div>
      <div class="field">
        <label for="price">Price (£)</label>
        <input id="price" type="number" name="price" min="0" step="0.5" value="{{cls.price}}" required />
      </div>
      <div class="field">
        <label for="description">Notes</label>
        <textarea id="description" name="description">{{cls.description}}</textarea>
      </div>
      <div class="form-row">
        <a href="/organiser/dashboard" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </main>

  {{> partials/foot}}
</body>
</html>
