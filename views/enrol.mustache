<!DOCTYPE html>
<html lang="en">
<head>
  <title>Enrol · {{course.name}} · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap">
    <a href="/course/{{course._id}}" class="back-link">← {{course.name}}</a>

    <div class="detail">
      <form action="/enrol/{{course._id}}" method="post" class="panel form-grid">
        <div>
          <span class="eyebrow">Enrol</span>
          <h1 class="page-title">{{course.name}}</h1>
        </div>

        <fieldset class="field">
          <legend class="label">Pick a session</legend>
          <div class="option-list">
            {{#classes}}
              <label class="option">
                <input type="radio" name="classId" value="{{_id}}" required {{#selected}}checked{{/selected}} />
                <span class="date-chip"><span class="m">{{month}}</span><span class="d">{{day}}</span></span>
                <span class="session-info">
                  <span class="session-title">{{weekday}} at {{time}} · {{priceLabel}}</span>
                  <span class="session-sub">{{location}}</span>
                </span>
                <span class="check" aria-hidden="true"></span>
              </label>
            {{/classes}}
          </div>
          {{^hasClasses}}<p class="empty">No sessions are open for this course yet.</p>{{/hasClasses}}
        </fieldset>

        <div class="field">
          <label for="name">Full name</label>
          <input id="name" type="text" name="name" placeholder="Alex Morgan" autocomplete="name" required />
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" placeholder="alex@example.com" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" type="tel" name="phone" placeholder="07700 900123" autocomplete="tel" required />
          </div>
        </div>

        <button type="submit" class="btn btn-primary">Confirm enrolment</button>
      </form>

      <aside class="panel book-card sticky">
        <h2>Good to know</h2>
        <ul class="book-facts">
          <li><span>Course length</span><strong>{{course.duration}}</strong></li>
          <li><span>Payment</span><strong>At the studio</strong></li>
          <li><span>Level</span><strong>All welcome</strong></li>
        </ul>
        <p>We only use your details to contact you about this class.</p>
      </aside>
    </div>
  </main>

  {{> partials/foot}}
</body>
</html>
