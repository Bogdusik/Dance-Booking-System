<!DOCTYPE html>
<html lang="en">
<head>
  <title>Participants · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap">
    <div class="page-head">
      <div>
        <span class="eyebrow">Organiser</span>
        <h1 class="page-title">Participants by session</h1>
        <p class="page-lead">Everyone who has booked, grouped by session in date order.</p>
      </div>
    </div>

    {{#classes}}
      <section class="panel class-block">
        <div class="session">
          <span class="date-chip"><span class="m">{{month}}</span><span class="d">{{day}}</span></span>
          <div class="session-info">
            <span class="session-title">{{courseName}}</span>
            <span class="session-sub">{{weekday}} at {{time}} · {{location}}</span>
          </div>
          <div class="session-side"><span class="badge badge-accent">{{countLabel}}</span></div>
        </div>
        {{#hasParticipants}}
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th>Email</th><th>Phone</th></tr></thead>
              <tbody>
                {{#participants}}
                  <tr>
                    <td><span class="cell-person"><span class="avatar">{{initials}}</span>{{name}}</span></td>
                    <td class="muted">{{email}}</td>
                    <td class="muted">{{phone}}</td>
                  </tr>
                {{/participants}}
              </tbody>
            </table>
          </div>
        {{/hasParticipants}}
        {{^hasParticipants}}<p class="empty">No bookings yet.</p>{{/hasParticipants}}
      </section>
    {{/classes}}
    {{^classes}}<p class="empty">No sessions scheduled.</p>{{/classes}}
  </main>

  {{> partials/foot}}
</body>
</html>
