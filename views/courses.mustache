<!DOCTYPE html>
<html lang="en">
<head>
  <title>Courses · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap">
    <div class="page-head">
      <div>
        <span class="eyebrow">This season</span>
        <h1 class="page-title">All courses</h1>
        <p class="page-lead">From one-weekend intensives to term-long blocks. Open a course to see every session and book a place.</p>
      </div>
    </div>

    <div class="course-grid">
      {{#courses}}{{> partials/course_card}}{{/courses}}
    </div>
    {{^courses}}<p class="empty">No courses yet. Check back soon.</p>{{/courses}}
  </main>

  {{> partials/foot}}
</body>
</html>
