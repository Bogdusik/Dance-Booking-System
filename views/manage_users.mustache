<!DOCTYPE html>
<html lang="en">
<head>
  <title>Users · Dance Booking</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap">
    <div class="page-head">
      <div>
        <span class="eyebrow">Organiser</span>
        <h1 class="page-title">Accounts</h1>
      </div>
    </div>

    <section class="panel">
      <div class="panel-head">
        <h2>Organisers</h2>
        <span class="count">{{organisers.length}}</span>
      </div>
      <div class="table-wrap">
        <table>
          <tbody>
            {{#organisers}}
              <tr>
                <td><span class="cell-person"><span class="avatar">{{initials}}</span>{{username}}</span></td>
                <td><span class="badge badge-accent">organiser</span></td>
                <td>
                  <div class="row-actions">
                    {{#isSelf}}<span class="muted">You</span>{{/isSelf}}
                    {{^isSelf}}
                      <form action="/organiser/delete-user/{{_id}}" method="post" data-confirm="Delete this organiser?">
                        <button class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    {{/isSelf}}
                  </div>
                </td>
              </tr>
            {{/organisers}}
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Members</h2>
        <span class="count">{{users.length}}</span>
      </div>
      {{#hasUsers}}
        <div class="table-wrap">
          <table>
            <tbody>
              {{#users}}
                <tr>
                  <td><span class="cell-person"><span class="avatar">{{initials}}</span>{{username}}</span></td>
                  <td><span class="badge">member</span></td>
                  <td>
                    <div class="row-actions">
                      <form action="/organiser/delete-user/{{_id}}" method="post" data-confirm="Delete this user?">
                        <button class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {{/users}}
            </tbody>
          </table>
        </div>
      {{/hasUsers}}
      {{^hasUsers}}<p class="empty">No members registered yet.</p>{{/hasUsers}}
    </section>
  </main>

  {{> partials/foot}}
</body>
</html>
