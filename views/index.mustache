<!DOCTYPE html>
<html lang="en">
<head>
  <title>Dance Booking · Community dance classes</title>
  {{> partials/head}}
</head>
<body>
  {{> partials/nav}}

  <main class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">Community dance classes</span>
        <h1 class="hero-title">Find your <em>rhythm</em>,<br />book your spot.</h1>
        <p class="hero-lead">
          Weekend workshops and 12-week blocks for every level of fitness and ability.
          Pick a course, choose a session that fits your week and you are on the list.
        </p>

        <div class="hero-actions">
          <a href="/courses" class="btn btn-primary">Browse courses</a>
          {{^user}}<a href="/auth/register" class="btn btn-ghost">Create an account</a>{{/user}}
          {{#isOrganiser}}<a href="/organiser/dashboard" class="btn btn-ghost">Open dashboard</a>{{/isOrganiser}}
        </div>

        <div class="hero-stats">
          <div><strong>{{stats.courses}}</strong><span>courses</span></div>
          <div><strong>{{stats.classes}}</strong><span>sessions</span></div>
          <div><strong>All</strong><span>levels welcome</span></div>
        </div>
      </div>

      <aside class="up-next" aria-label="Upcoming sessions">
        <div class="up-next-head">
          <h2>Coming up</h2>
          <span class="live-dot">Booking open</span>
        </div>
        <div class="session-list">
          {{#upcoming}}
            <a class="session" href="/course/{{courseId}}">
              <span class="date-chip"><span class="m">{{month}}</span><span class="d">{{day}}</span></span>
              <span class="session-info">
                <span class="session-title">{{courseName}}</span>
                <span class="session-sub">{{weekday}} · {{time}} · {{location}}</span>
              </span>
              <span class="session-price">{{priceLabel}}</span>
            </a>
          {{/upcoming}}
          {{^upcoming}}<p class="empty">No sessions scheduled yet.</p>{{/upcoming}}
        </div>
      </aside>
    </section>

    {{#featured.length}}
    <section class="section">
      <div class="page-head">
        <div>
          <span class="eyebrow">Popular right now</span>
          <h2 class="page-title">Start with these</h2>
        </div>
        <a href="/courses" class="btn btn-ghost btn-sm">All courses →</a>
      </div>
      <div class="course-grid">
        {{#featured}}{{> partials/course_card}}{{/featured}}
      </div>
    </section>
    {{/featured.length}}
  </main>

  {{> partials/foot}}
</body>
</html>
